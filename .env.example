# 루트 .env 로 복사해서 채운다. compose(변수 치환)와 backend 컨테이너(env_file) 둘 다 이 파일을 읽는다.
# 주의: 고객·개인정보는 절대 넣지 않는다. .env 는 git 에 올리지 않는다.

# ── 백엔드 ──────────────────────────────────────────────
BACKEND_PORT=8000
# gadget: Linux 에서 Inspektor Gadget 으로 실제 커널 이벤트 수집 (root)  |  mock: 로컬 데모 이벤트
EVENT_SOURCE=gadget
GADGETS=exec,open,connect
# 컨테이너 탐색 방법: docker-events(기본, Docker Desktop 포함 어디서나) | fanotify(IG 기본 runc 훅, Docker Desktop 에선 안 됨)
CONTAINER_DISCOVERY=docker-events
# trace_dns 를 함께 돌려 connect 이벤트에 목적지 도메인을 붙인다 (allowHosts/denyHosts 에 필요)
RESOLVE_DNS=true
# 특정 컨테이너만 관찰하려면 이름을 넣는다. 비우면 전체.
CONTAINER_NAME=
# 이 목록이 있으면 맞는 이름의 컨테이너만 평가·격리 (설치 샌드박스: sg-install-*). 개발 PC 오탐 격리 방지.
WATCH_CONTAINERS=
# 관찰에서 제외할 컨테이너 이름 glob (자기 스택 보호)
IGNORE_CONTAINERS=supplyguard-*
# false 면 kill 정책도 알림만 (전역 dry-run). 데모에서 실제 격리를 보려면 true
ENFORCE_KILL=false
DOCKER_HOST=unix:///var/run/docker.sock
# 비우면 메모리 저장소. compose 가 postgres/redis 서비스 주소로 덮어쓴다.
DATABASE_URL=
REDIS_URL=
POLICY_FILE=policies/default.yaml
# 화면 쓰기(정책 변경 · 판정 · 제안 적용 · 차단 해제) 보호 토큰. 비어 있으면 그 쓰기 API 가 403 (mock 소스만 예외)
ADMIN_TOKEN=
# sg-install CLI 의 설치 세션 보고 · 차단 목록 확인 전용 토큰 (ADMIN_TOKEN 과 다른 값, 같으면 백엔드가 시작하지 않는다).
# CLI 쪽에는 SUPPLYGUARD_SANDBOX_TOKEN 으로 같은 값을 넣는다. 비어 있으면 보고 · 확인이 403 (mock 소스만 예외)
SANDBOX_TOKEN=
# 판정 · 적용 · 정책 변경 기록에 남는 처리자 이름 (데모 계정 하나)
ACTOR_NAME=보안 담당자
# 대시보드 WebSocket Origin + REST CORS 허용 목록 — 실제 접속 주소를 모두 적는다 (콤마 구분).
# 목업(mock/)을 '실제 백엔드' 모드로 붙이려면 http://127.0.0.1:8766 (python http.server) 또는 null (file:// 로 연 경우) 도 넣는다.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://203.0.113.10
# 정상 판정 이벤트를 WebSocket 으로 보내는 초당 상한 (위반은 항상 전송)
NORMAL_EVENT_RATE=50
LOG_LEVEL=INFO

# ── 저장소 ──────────────────────────────────────────────
POSTGRES_DB=supplyguard
POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=

# ── 배포 ────────────────────────────────────────────────
# Docker Hub 사용자명 (이미지 이름 접두어). 로컬 빌드만 하면 비워 두어도 된다(local/…).
DOCKERHUB_USERNAME=
IMAGE_TAG=dev
HTTP_PORT=80
HTTPS_ENABLED=false
# HTTPS_ENABLED=true 일 때 Caddy 가 인증서를 받을 도메인
PUBLIC_HOST=

# 공급망 검사(10/16): 작업 볼륨(백엔드 경로 · Docker 볼륨 이름 = <compose 프로젝트>_scan_work) · 검사기 이미지
SCAN_DIR=/scan
SCAN_VOLUME=supplyguard_scan_work
GUARDDOG_IMAGE=ghcr.io/datadog/guarddog:latest
OSV_SCANNER_IMAGE=ghcr.io/google/osv-scanner:latest
