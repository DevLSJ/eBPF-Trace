# 루트 .env 로 복사해서 채운다. compose(변수 치환)와 backend 컨테이너(env_file) 둘 다 이 파일을 읽는다.
# 주의: 고객·개인정보는 절대 넣지 않는다. .env 는 git 에 올리지 않는다.

# ── 백엔드 ──────────────────────────────────────────────
BACKEND_PORT=8000
# gadget: Linux 에서 Inspektor Gadget 으로 실제 커널 이벤트 수집 (root)  |  mock: 로컬 데모 이벤트
EVENT_SOURCE=gadget
GADGETS=exec,open,connect
# 컨테이너 탐색 방법: auto(기본, fanotify 를 먼저 시도하고 안 되면 docker-events) | fanotify(IG 기본 runc 훅, 시작 직후 동작까지 봄, Docker Desktop 에선 안 됨) | docker-events(Docker 이벤트 API, 시작 직후 약 0.1초 안의 동작은 놓칠 수 있음)
CONTAINER_DISCOVERY=auto
# trace_dns 를 함께 돌려 connect 이벤트에 목적지 도메인을 붙인다 (allowHosts/denyHosts 에 필요)
RESOLVE_DNS=true
# connect 가 DNS 응답보다 먼저 올 때 도메인 없는 공인 IP 연결을 이만큼(ms) 기다렸다 다시 조회한다. 0 = 바로 평가
DNS_GRACE_MS=200
# 특정 컨테이너만 관찰하려면 이름을 넣는다. 비우면 전체.
CONTAINER_NAME=
# 이 목록이 있으면 맞는 이름의 컨테이너만 평가·격리 (설치 샌드박스: sg-install-*). 개발 PC 오탐 격리 방지.
WATCH_CONTAINERS=
# 관찰에서 제외할 컨테이너 이름 glob (자기 스택 보호)
IGNORE_CONTAINERS=supplyguard-*
# false 면 kill 정책도 알림만 (전역 dry-run). 데모에서 실제 격리를 보려면 true
ENFORCE_KILL=false
# 시연 전용 — true 면 대시보드 「시연」 카드와 POST /api/demo/run 이 열려 관리자가 sg-install-demo-* 컨테이너(이미지 SG_PIP_IMAGE, 기본 python:3.12-slim)에
# 데모 패키지(reqeusts)를 설치해 탐지 · 격리를 보여 준다. 운영은 끈다(기본 false). make dev · make backend 는 true 로 띄운다
DEMO_ENABLED=false
DOCKER_HOST=unix:///var/run/docker.sock
# 비우면 메모리 저장소. compose 가 postgres/redis 서비스 주소로 덮어쓴다.
DATABASE_URL=
REDIS_URL=
POLICY_FILE=policies/default.yaml
# CLI · 자동화용 관리자 토큰(Authorization: Bearer). 화면은 로그인 계정으로 쓴다. 비어 있으면 Bearer 접근은 모두 401
ADMIN_TOKEN=
# sg-install CLI 의 설치 세션 보고 · 차단 목록 확인 전용 토큰 (ADMIN_TOKEN 과 다른 값, 같으면 백엔드가 시작하지 않는다).
# CLI 쪽에는 SUPPLYGUARD_SANDBOX_TOKEN 으로 같은 값을 넣는다. 비어 있으면 보고 · 확인이 403 (mock 소스만 예외)
SANDBOX_TOKEN=
# 판정 · 적용 · 정책 변경 기록의 처리자는 로그인 계정의 표시 이름(Bearer CLI 는 「cli」). 요청자를 알 수 없을 때만 이 이름
ACTOR_NAME=보안 담당자
# 대시보드 WebSocket Origin + REST CORS 허용 목록 — 실제 접속 주소를 모두 적는다 (콤마 구분).
# 목업(mock/)을 '실제 백엔드' 모드로 붙이려면 http://127.0.0.1:8766 (python http.server) 또는 null (file:// 로 연 경우) 도 넣는다.
# 아래 203.0.113.10 은 문서용 예시 주소(RFC 5737) — 실제 서버 주소로 바꾼다
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://203.0.113.10
# 정상 판정 이벤트를 WebSocket 으로 보내는 초당 상한 (위반은 항상 전송)
NORMAL_EVENT_RATE=50
LOG_LEVEL=INFO

# ── 저장소 ──────────────────────────────────────────────
POSTGRES_DB=supplyguard
POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=

# ── 배포 ────────────────────────────────────────────────
# Docker Hub 사용자명 (이미지 이름 접두어). 로컬 빌드만 하면 비워 두어도 된다(local/…).
DOCKERHUB_USERNAME=
IMAGE_TAG=dev
HTTP_PORT=80
HTTPS_ENABLED=false
# HTTPS_ENABLED=true 일 때 Caddy 가 인증서를 받을 도메인
PUBLIC_HOST=

# 공급망 검사(10/16): 작업 볼륨(백엔드 경로 · Docker 볼륨 이름 = <compose 프로젝트>_scan_work) · 검사기 이미지
SCAN_DIR=/scan
SCAN_VOLUME=supplyguard_scan_work
GUARDDOG_IMAGE=ghcr.io/datadog/guarddog:latest
OSV_SCANNER_IMAGE=ghcr.io/google/osv-scanner:latest
# 종합 판정(11/04): sg-install 세션 보고 때 서버가 첫 패키지의 정적 검사를 자동으로 시작한다(on | off). off 면 설치 화면은 예전처럼 OSV 이름 조회만
SCAN_AUTO=on
# 검사 동시 실행 상한(수동 검사 포함, 1 이상) · 자동 검사 대기 상한(1 이상 — 실행 + 대기가 「동시 + 대기」에 차면 자동 검사는 건너뜀 busy, 수동 검사는 기다린다)
# 자리를 기다리는 검사는 10분까지(넘으면 「대기 시간 초과」 실패), 검사 한 건은 자리를 잡은 뒤 8분까지
SCAN_CONCURRENCY=1
SCAN_QUEUE=4
# 검사기 컨테이너 하나의 메모리(MB, 128 이상) · CPU(코어, 소수 가능). 한도에 걸려 죽으면(종료 코드 137) 「검사기 메모리 부족」 실패
# 기본 1024 · 2. sg-ec2(t4g.small, 메모리 2GB)에서는 768 · 1 권장(11/03 결정)
SCAN_MEMORY_MB=1024
SCAN_CPUS=2

# 외부 알림(격리 · 경고 · 건 열림 · 제안 대기): 범용 웹훅(JSON POST) · Slack incoming webhook. 둘 다 비우면 비활성. 5초 제한 · 3회 재시도 · 같은 컨테이너 · 규칙은 60초에 한 번
NOTIFY_WEBHOOK_URL=
NOTIFY_SLACK_URL=
# 알림에 넣는 대시보드 주소(예: https://sg.example.com). 비우면 링크를 경로(/installs?id=…)만 보낸다
PUBLIC_URL=
# ── 로그인 · 라이선스 · OTP ─────────────────────────────
# /health 를 뺀 모든 화면 · API · WebSocket 은 로그인 뒤에 있다. 예외: sg-install 보고(SANDBOX_TOKEN), CLI · 자동화(Authorization: Bearer ADMIN_TOKEN = 관리자, 기록 처리자 「cli」)
# 계정이 하나도 없을 때만 이 이름 · 비밀번호로 관리자 1명을 만든다(이미 있으면 무시). 첫 로그인에서 비밀번호 변경 필수.
# 비밀번호는 5자 이상 · 아이디와 달라야 한다. 계정이 없는데 비었거나 짧으면 백엔드가 시작하지 않는다. 계정을 만든 뒤에는 지워도 된다.
# (make dev · make backend 는 개발용 고정값과 AUTH_OTP_REQUIRED=false 를 Makefile 의 DEV_AUTH 로 넣는다 — 여기 값과 무관)
ADMIN_USER=admin
ADMIN_INITIAL_PASSWORD=
# 로그인 OTP(Google Authenticator 등, RFC 6238) 필수 여부. 운영은 true, 개발(make dev) · e2e 만 false
AUTH_OTP_REQUIRED=true
# HTTPS 로 접속할 때 true — 세션 쿠키에 Secure 를 붙인다 (HTTP 에서 true 면 로그인이 유지되지 않는다)
AUTH_COOKIE_SECURE=false
# DB 의 OTP 비밀값을 AES-GCM 으로 암호화하는 키. EVENT_SOURCE=gadget 이면 필수(32자 이상, 아니면 시작하지 않음), mock 은 선택.
# 생성: openssl rand -hex 32   — 한 번 정하면 바꾸지 않는다(바꾸면 기존 OTP 를 초기화해야 한다)
AUTH_SECRET_KEY=


# AI 도우미(10/20): 비우면 챗봇 비활성. compose 는 `--profile ai` 로 ollama 서비스를 함께 띄운다
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
