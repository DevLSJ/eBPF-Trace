# ---- LLM (Anthropic) ----
ANTHROPIC_BASE_URL=https://ai.cs.kookmin.ac.kr
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MODEL_CHEAP=claude-haiku-4-5
LLM_EFFORT=medium
# 2단계 분석(저렴한 모델 → 정밀 모델). 중계 토큰이 haiku만 허용하면 false (ADR-021)
LLM_TWO_STAGE=false

# ---- GitHub ----
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ---- Infra ----
DATABASE_URL=postgresql://capstone:capstone@localhost:5433/capstone
REDIS_URL=redis://localhost:6380/0

# ---- Auth ----
ADMIN_PASSWORD=
SESSION_SECRET=

# ---- Services ----
GATEWAY_PORT=4000
ENGINE_PORT=8000
ENGINE_URL=http://localhost:8000
# 분석 처리 서비스 (ADR-020). gateway가 상태 확인에 사용
ANALYZER_PORT=4100
ANALYZER_URL=http://localhost:4100
# 비워두면 브라우저 접속 호스트의 :4000 사용(LAN IP·폰 접속 지원). 고정이 필요할 때만 지정
NEXT_PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_WS_URL=

# ---- Alerts ----
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ---- CI Gate ----
GATE_TOKEN=

# ---- ngrok (로컬 Webhook 터널) ----
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# 런타임 에이전트 인증 (docs/13 §3.2)
AGENT_TOKEN=
