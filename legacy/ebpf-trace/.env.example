# DB
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ebpf_ids
DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379
REDIS_WINDOW_SIZE_SEC=60

# ML 엔진
MODEL_PATH=/app/models/isolation_forest.pkl
SCALER_PATH=/app/models/scaler.pkl
ANOMALY_THRESHOLD=-0.1
IF_CONTAMINATION=0.05

# Rule-based 임계값
SYN_RATIO_THRESHOLD=0.8
SYN_PPS_THRESHOLD=1000
PORT_ENTROPY_THRESHOLD=3.5
PORT_CNT_THRESHOLD=20
SPIKE_THRESHOLD_MULTIPLIER=10
BASELINE_PPS=1000
LARGE_FLOW_THRESHOLD=12500000

# 알림
SLACK_WEBHOOK_URL=
SLACK_ENABLED=false

# 사건 대응 워크스페이스: 실제 운영은 HTTPS와 개인 운영자 계정 필요
PUBLIC_BASE_URL=http://127.0.0.1:5173
OPS_ALLOW_INSECURE_LOCAL=false
OPS_WORKER_ENABLED=true
OPS_NOTIFICATIONS_ENABLED=false
OPS_SESSION_HOURS=8
OPS_RETENTION_DAYS=30
INCIDENT_WINDOW_SECONDS=600
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_CHANNEL=
SLACK_ESCALATION_CHANNEL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=

# ML 후보: 새 manifest로 등록되며 기본 Offline, 독립 검증 없이 승격 불가
SHADOW_MANIFEST_PATH=
SHADOW_SAMPLE_MODULUS=100

# 현장 대응: 기본 비활성. 실제 차단은 별도 승인·허용 서비스·에이전트 필요
RESPONSE_LIVE_ENABLED=false
RESPONSE_MAX_TTL_SECONDS=300
RESPONSE_FRESHNESS_SECONDS=30
RECOVERY_OBSERVATION_SECONDS=60

# 에이전트
IFACE=eth0
COLLECTOR_WS_URL=
COLLECTOR_TOKEN=
OUTBOX_PATH=collector-outbox.db
RING_BUFFER_POLL_MS=100

# 서버
BACKEND_PORT=8000
LOG_LEVEL=INFO
METRICS_COLLECT_INTERVAL_SEC=10
ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCKERHUB_USERNAME=
IMAGE_TAG=dev
DEV_POSTGRES_PASSWORD=
