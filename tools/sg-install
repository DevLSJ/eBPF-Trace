#!/usr/bin/env bash
# sg-install — 오픈소스 패키지를 개발자 PC 에 바로 설치하지 않고, SupplyGuard 가 감시하는 일회용 컨테이너 안에서 설치한다.
# 설치 스크립트(post-install)가 외부 스크립트를 실행하거나, 자격 증명 파일을 읽거나, 레지스트리 밖으로 접속하면
# 커널(eBPF)에서 잡혀 컨테이너가 즉시 격리(SIGKILL)된다. 차단 목록의 패키지는 컨테이너를 띄우기 전에 거부한다.
#
#   sg-install pip requests               # PyPI 패키지
#   sg-install npm lodash@4               # npm 패키지
#   sg-install cargo ripgrep              # crates.io
#   sg-install pip ./deploy/demo/reqeusts # 로컬 디렉터리(악성 데모 패키지)를 읽기 전용으로 마운트
#   sg-install --keep pip requests        # 설치 결과를 살펴보려면 컨테이너를 남긴다
#
# 종료 코드: 0 통과 · 1 설치 실패 · 2 위반(격리 · 경고) · 3 차단 목록이라 설치 전 거부 · 4 결과 확인 불가(통과로 보지 않는다)
#           · 69 백엔드 연결 실패 · 77 토큰 거부
# 환경: SUPPLYGUARD_API (기본 http://127.0.0.1:8000), SUPPLYGUARD_SANDBOX_TOKEN (백엔드 SANDBOX_TOKEN, mock 소스는 없어도 됨)
#       SG_PIP_IMAGE / SG_NPM_IMAGE / SG_CARGO_IMAGE
set -euo pipefail

api=${SUPPLYGUARD_API:-http://127.0.0.1:8000}
keep=0
while [[ $# -gt 0 && $1 == --* ]]; do
  case $1 in
    --keep) keep=1 ;;
    --api) api=$2; shift ;;
    *) echo "unknown option $1" >&2; exit 64 ;;
  esac
  shift
done
mgr=${1:-}; shift || true
[[ -n $mgr && $# -gt 0 ]] || { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 64; }
raw=("$@") # 보고 · 차단 확인에는 사용자가 적은 그대로 보낸다 (정규화는 백엔드가 한다)

# 빈 배열은 "${a[@]+"${a[@]}"}" 로 펼친다 — macOS 기본 bash 3.2 는 set -u 에서 빈 "${a[@]}" 를 unbound 오류로 본다
auth=()
[[ -n ${SUPPLYGUARD_SANDBOX_TOKEN:-} ]] && auth=(-H "Authorization: Bearer $SUPPLYGUARD_SANDBOX_TOKEN")

# api_call METHOD PATH [JSON] — 응답 본문은 $resp, 상태 코드는 $http_code (연결 실패면 000)
api_call() {
  local args=(-sS -m 5 -X "$1" -w $'\n%{http_code}' ${auth[@]+"${auth[@]}"})
  [[ -n ${3:-} ]] && args+=(-H 'Content-Type: application/json' --data-binary "$3")
  local out
  if ! out=$(curl "${args[@]}" "$api$2" 2>/dev/null); then http_code=000; resp=; return 1; fi
  http_code=${out##*$'\n'}; resp=${out%$'\n'*}
}
# jget JSON KEY — 문자열은 그대로, true/false 는 소문자, 없으면 빈 문자열
jget() { python3 -c 'import json,sys; v=json.loads(sys.argv[1]).get(sys.argv[2]); print("" if v is None else (json.dumps(v) if isinstance(v,bool) else v))' "$1" "$2" 2>/dev/null || true; }
urlenc() { python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"; }

name="sg-install-$mgr-$(date +%s)-$RANDOM"
mounts=(); pkgs=()
for p in "$@"; do
  if [[ -d $p ]]; then
    abs=$(cd "$p" && pwd); base=$(basename "$abs")
    mounts+=(-v "$abs:/pkg/$base:ro"); pkgs+=("/pkg/$base")
  else
    pkgs+=("$p")
  fi
done

case $mgr in
  pip)   image=${SG_PIP_IMAGE:-python:3.12-slim};  cmd=(pip install --no-cache-dir --progress-bar off "${pkgs[@]}") ;;
  npm)   image=${SG_NPM_IMAGE:-node:22-alpine};    cmd=(sh -c 'cd /work && npm init -y >/dev/null && npm install --no-fund --no-audit "$@"' -- "${pkgs[@]}") ;;
  cargo) image=${SG_CARGO_IMAGE:-rust:1-slim};     cmd=(cargo install "${pkgs[@]}") ;;
  *) echo "지원: pip | npm | cargo (받은 값: $mgr)" >&2; exit 64 ;;
esac

# 가젯 확인은 공개된 /health 의 source 로 한다 (/api/info 는 로그인 뒤)
if ! health=$(curl -fsS -m 3 "$api/health" 2>/dev/null); then
  echo "SupplyGuard 백엔드($api)에 연결할 수 없습니다. make sandbox-up 으로 먼저 띄우세요." >&2; exit 69
fi
if [[ $(jget "$health" source) != gadget ]]; then
  echo "경고: 백엔드가 가젯 소스가 아닙니다. 설치는 진행하지만 커널 감시는 없습니다." >&2
fi

# 1. 차단 목록 사전 확인 — 하나라도 차단이면 컨테이너 없이 거부(종료 코드 3). 확인이 안 되면 설치하지 않는다(fail-closed).
for p in "${raw[@]}"; do
  api_call GET "/api/blocklist/check?manager=$(urlenc "$mgr")&package=$(urlenc "$p")" || true
  case $http_code in
    200) ;;
    401|403) echo "차단 목록 확인이 거부됨(HTTP $http_code) — SUPPLYGUARD_SANDBOX_TOKEN 을 확인하세요. 설치하지 않습니다." >&2; exit 77 ;;
    *) echo "차단 목록 확인 실패(HTTP $http_code) ${resp:-} — 설치하지 않습니다." >&2; exit 69 ;;
  esac
  if [[ $(jget "$resp" blocked) == true ]]; then
    value=$(jget "$resp" value); case_id=$(jget "$resp" caseId)
    body=$(python3 -c 'import json,sys; print(json.dumps({"manager":sys.argv[1],"value":sys.argv[2],"packages":sys.argv[3:]}))' "$mgr" "$value" "${raw[@]}")
    api_call POST /api/installs/refused "$body" || true
    [[ $http_code == 201 ]] || echo "경고: 거부 기록을 남기지 못했습니다(HTTP $http_code)." >&2
    echo "[거부] $p 는 차단 목록($value)에 있어 설치하지 않습니다${case_id:+ — 판정 건 $case_id}."
    exit 3
  fi
done

# 2. 세션 시작 보고 — 실패해도 설치는 진행한다(커널 감시는 그대로, 화면 기록만 빠진다)
body=$(python3 -c 'import json,sys; print(json.dumps({"manager":sys.argv[1],"container":sys.argv[2],"image":sys.argv[3],"packages":sys.argv[4:]}))' "$mgr" "$name" "$image" "${raw[@]}")
session=
if api_call POST /api/installs "$body" && [[ $http_code == 201 ]]; then
  session=$(jget "$resp" id)
else
  echo "경고: 설치 세션을 보고하지 못했습니다(HTTP $http_code). 「설치 검사」 화면에 기록이 남지 않습니다." >&2
fi

echo "▶ $mgr install ${pkgs[*]}"
echo "  컨테이너 $name ($image) — SupplyGuard 감시 중${session:+ · 세션 $session}"
set +e
docker run --name "$name" --label supplyguard.sandbox=1 -w /work --pull missing ${mounts[@]+"${mounts[@]}"} "$image" "${cmd[@]}" 2>&1 | sed 's/^/  | /'
code=${PIPESTATUS[0]}
set -e

# 3. 끝 보고 (종료 코드). 보고가 없으면 백엔드는 컨테이너 종료 10분 뒤 「결과 미확인」으로 둔다.
#    결과는 이 응답(설치 세션 + 위반 요약)에서 읽는다 — 감사 로그 · 화면 API 는 로그인 뒤라 CLI 가 읽지 않는다.
#    커널 이벤트가 파이프라인을 다 지나도록 잠깐 기다린 뒤 보고한다(보고 시점의 위반이 응답에 담긴다).
sleep 1.5
result=
if [[ -n $session ]]; then
  if api_call PUT "/api/installs/$session/finish" "{\"exitCode\": $code}" && [[ $http_code == 200 ]]; then
    result=$resp
  else
    echo "경고: 설치 종료를 보고하지 못했습니다(HTTP $http_code)." >&2
  fi
fi

# 4. 결과 출력. 결과를 받지 못하면 「결과 확인 불가」(종료 코드 4) — 절대 「위반 없음」으로 바꾸지 않는다
set +e
python3 - "$result" "$code" <<'PY'
import json, sys
raw, code = sys.argv[1], int(sys.argv[2])
done = "완료" if code == 0 else "실패"
def unknown(why):
    print("\n[결과 확인 불가] %s — 설치 %s (종료 코드 %d)" % (why, done, code))
    print("이 결과를 통과로 보지 마세요. 대시보드 -> 설치 검사에서 이 설치의 판정을 확인하세요.")
    sys.exit(4)
if not raw:
    unknown("백엔드에서 설치 결과를 받지 못했습니다")
try:
    r = json.loads(raw)
    status, n = r["status"], int(r["violationCount"])
except Exception:
    unknown("백엔드 응답을 읽을 수 없습니다")
if n == 0:
    if status not in ("passed", "failed"):
        unknown("위반 0건인데 판정이 %r 입니다" % status)
    print("\n[OK] 위반 없음 — 설치 %s (종료 코드 %d)" % (done, code)); sys.exit(0 if code == 0 else 1)
def detail(e):
    return e.get("args") or e.get("path") or ("%s:%s%s" % (e.get("dstIp"), e.get("dstPort"), " (%s)" % e["dstHost"] if e.get("dstHost") else ""))
vs = r.get("violations") or []
killed = status == "isolated" or any(v.get("enforced") for v in vs)
print("\n[%s] 위반 %d건%s" % ("격리됨" if killed else "경고", n, " — 컨테이너를 SIGKILL 로 격리했습니다" if killed else " (dry-run: 알림만)"))
for i, v in enumerate(vs[:20], 1):
    e = v.get("event") or {}
    print("  %d. [%-7s] %-22s %s  x%d" % (i, e.get("kind", ""), v.get("ruleId", ""), detail(e)[:80], v.get("count", 1)))
    print("     %s%s" % (v.get("reason", ""), "  <- 격리" if v.get("enforced") else ""))
if len(vs) > 20:
    print("  … 외 %d종" % (len(vs) - 20))
top = r.get("topRules") or []
if top:
    print("  많이 걸린 규칙: " + ", ".join("%s %d건" % (t["ruleId"], t["count"]) for t in top))
if r.get("caseId"):
    print("  판정 건: %s" % r["caseId"])
if r.get("link"):
    print("  대시보드 설치 검사: %s" % r["link"])
print("\n이 패키지를 설치하지 마세요. 대시보드 -> 설치 검사에서 판정하면 차단 목록에 올라갑니다.")
sys.exit(2)
PY
rc=$?
set -e
[[ $keep == 1 ]] || docker rm -f "$name" >/dev/null 2>&1 || true
exit $rc
