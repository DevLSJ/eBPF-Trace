#!/usr/bin/env bash
# sg-install — 오픈소스 패키지를 개발자 PC 에 바로 설치하지 않고, SupplyGuard 가 감시하는 일회용 컨테이너 안에서 설치한다.
# 설치 스크립트(post-install)가 외부 스크립트를 실행하거나, 자격 증명 파일을 읽거나, 레지스트리 밖으로 접속하면
# 커널(eBPF)에서 잡혀 컨테이너가 즉시 격리(SIGKILL)되고, 이 스크립트는 위반 목록을 출력한 뒤 종료 코드 2 로 끝난다.
#
#   sg-install pip requests               # PyPI 패키지
#   sg-install npm lodash@4               # npm 패키지
#   sg-install cargo ripgrep              # crates.io
#   sg-install pip ./deploy/demo/reqeusts # 로컬 디렉터리(악성 데모 패키지)를 읽기 전용으로 마운트
#   sg-install --keep pip requests        # 설치 결과를 살펴보려면 컨테이너를 남긴다
#
# 필요: 같은 Docker 호스트에서 SupplyGuard 백엔드가 가젯 소스로 돌고 있어야 한다 (make sandbox-up).
# 환경: SUPPLYGUARD_API (기본 http://127.0.0.1:8000), SG_PIP_IMAGE / SG_NPM_IMAGE / SG_CARGO_IMAGE
set -euo pipefail

api=${SUPPLYGUARD_API:-http://127.0.0.1:8000}
keep=0
while [[ $# -gt 0 && $1 == --* ]]; do
  case $1 in
    --keep) keep=1 ;;
    --api) api=$2; shift ;;
    *) echo "unknown option $1" >&2; exit 64 ;;
  esac
  shift
done
mgr=${1:-}; shift || true
[[ -n $mgr && $# -gt 0 ]] || { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 64; }

name="sg-install-$mgr-$(date +%s)-$RANDOM"
mounts=(); pkgs=()
for p in "$@"; do
  if [[ -d $p ]]; then
    abs=$(cd "$p" && pwd); base=$(basename "$abs")
    mounts+=(-v "$abs:/pkg/$base:ro"); pkgs+=("/pkg/$base")
  else
    pkgs+=("$p")
  fi
done

case $mgr in
  pip)   image=${SG_PIP_IMAGE:-python:3.12-slim};  cmd=(pip install --no-cache-dir --progress-bar off "${pkgs[@]}") ;;
  npm)   image=${SG_NPM_IMAGE:-node:22-alpine};    cmd=(sh -c 'cd /work && npm init -y >/dev/null && npm install --no-fund --no-audit "$@"' -- "${pkgs[@]}") ;;
  cargo) image=${SG_CARGO_IMAGE:-rust:1-slim};     cmd=(cargo install "${pkgs[@]}") ;;
  *) echo "지원: pip | npm | cargo (받은 값: $mgr)" >&2; exit 64 ;;
esac

if ! curl -fsS -m 3 "$api/health" >/dev/null 2>&1; then
  echo "SupplyGuard 백엔드($api)에 연결할 수 없습니다. make sandbox-up 으로 먼저 띄우세요." >&2; exit 69
fi
if ! curl -fsS -m 3 "$api/api/info" 2>/dev/null | grep -q '"source":"gadget"'; then
  echo "경고: 백엔드가 가젯 소스가 아닙니다. 설치는 진행하지만 커널 감시는 없습니다." >&2
fi

echo "▶ $mgr install ${pkgs[*]}"
echo "  컨테이너 $name ($image) — SupplyGuard 감시 중"
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
set +e
docker run --name "$name" --label supplyguard.sandbox=1 -w /work --pull missing "${mounts[@]}" "$image" "${cmd[@]}" 2>&1 | sed 's/^/  | /'
code=${PIPESTATUS[0]}
set -e
sleep 1.5

audit=$(curl -fsS -m 5 "$api/api/audit?container=$name&since=$started&limit=200" 2>/dev/null || echo '[]')
python3 - "$audit" "$code" <<'PY'
import json, sys
rows = json.loads(sys.argv[1]); code = int(sys.argv[2]); rows.reverse()
def detail(e):
    return e.get("args") or e.get("path") or ("%s:%s%s" % (e.get("dstIp"), e.get("dstPort"), " (%s)" % e["dstHost"] if e.get("dstHost") else ""))
if not rows:
    print("\n[OK] 위반 없음 — 설치 %s (종료 코드 %d)" % ("완료" if code == 0 else "실패", code)); sys.exit(0 if code == 0 else 1)
killed = any(r.get("enforced") for r in rows)
print("\n[%s] 위반 %d건%s" % ("격리됨" if killed else "경고", len(rows), " — 컨테이너를 SIGKILL 로 격리했습니다" if killed else " (dry-run: 알림만)"))
for i, r in enumerate(rows, 1):
    e = r["event"]
    print("  %d. [%-7s] %-22s %s" % (i, e["kind"], r.get("ruleId", ""), detail(e)[:90]))
    print("     %s%s" % (r.get("reason", ""), "  <- 격리" if r.get("enforced") else ""))
print("\n이 패키지를 설치하지 마세요. 대시보드 -> 이벤트에서 컨테이너 이름으로 원본 이벤트를 볼 수 있습니다.")
sys.exit(2)
PY
rc=$?
[[ $keep == 1 ]] || docker rm -f "$name" >/dev/null 2>&1 || true
exit $rc
